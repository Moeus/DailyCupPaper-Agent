# Agent: only the Agent container receives model/search credentials.
# Local backend URL; Compose overrides this to http://agent:8000 (no public port).
DCP_AGENT_URL=http://localhost:8000
DCP_AGENT_API_KEY=dev-agent-key-replace-with-at-least-32-random-bytes
DCP_RESEARCH_QUOTA_TIME_ZONE=Asia/Shanghai
# 学术文献调研 Agent 的模型配置；凭据与翻译 Agent 相互独立。
# 使用的 Qwen 模型名称。
DCP_RESEARCH_AGENT_MODEL=qwen-plus
# 研究模型的 API Key，必填。
DCP_RESEARCH_AGENT_API_KEY=
# OpenAI 兼容接口地址。
DCP_RESEARCH_AGENT_API_BASE=https://llm-25y6gpisv0ejnxo8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 生成温度；0 更适合可核查的文献报告。
DCP_RESEARCH_AGENT_TEMPERATURE=0
# 单次模型响应最多输出的 token 数。
DCP_RESEARCH_AGENT_MAX_TOKENS=4096
# 单次模型请求的超时秒数。
DCP_RESEARCH_AGENT_TIMEOUT_SECONDS=90

# 研究图预算；均可在单次 LangGraph 运行的 configurable 中用不带 DCP_RESEARCH_ 前缀的字段名覆盖。
# 主管最多进行的决策轮数。
DCP_RESEARCH_MAX_SUPERVISOR_ITERATIONS=5
# 主管每轮最多并行派发的研究员数；论文 API 自身仍按速率限制串行请求。
DCP_RESEARCH_MAX_CONCURRENT_RESEARCHERS=3
# 每位研究员最多进行的决策轮数。
DCP_RESEARCH_MAX_RESEARCHER_ITERATIONS=8
# 研究员单轮最多执行的工具调用数。
DCP_RESEARCH_MAX_TOOL_CALLS_PER_TURN=3
# 支持 limit 参数的工具每次最多请求的文献条数。
DCP_RESEARCH_MAX_PAPERS_PER_CALL=10
# 每条工具结果传给模型前保留的最大字符数。
DCP_RESEARCH_MAX_TOOL_RESULT_CHARS=24000
# Translation Agent (Alibaba Cloud Qwen). Never falls back to research Agent settings.
DCP_TRANSLATION_AGENT_MODEL=qwen-plus
DCP_TRANSLATION_AGENT_API_KEY=
DCP_TRANSLATION_AGENT_API_BASE=https://llm-25y6gpisv0ejnxo8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DCP_TRANSLATION_AGENT_TEMPERATURE=0
DCP_TRANSLATION_AGENT_MAX_TOKENS=4096
DCP_TRANSLATION_AGENT_TIMEOUT_SECONDS=90
# Research tools and shared tracing (not model configuration).
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dailycuppaper
